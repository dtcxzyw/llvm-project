@@ -453,6 +453,7 @@ class llvm::GVNPassImpl {
   bool
   propagateEquality(Value *LHS, Value *RHS,
                     const std::variant<BasicBlockEdge, Instruction *> &Root);
+  bool foldOutsideConstExpr(Value *LHS, Value *RHS, const BasicBlockEdge &Root);
